{
  "name": "analyze-deps",
  "version": "1.0.0",
  "description": "CLI wrapper around pnpm why",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/entry.ts --bundle --platform=node --outfile=bin/analyze-deps && chmod +x bin/analyze-deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup": "npm run build && npm i -g ."
  },
  "keywords": [],
  "author": "KriXPello",
  "license": "MIT",
  "dependencies": {
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "@types/yargs": "17.0.32",
    "esbuild": "0.28.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "bin": {
    "analyze-deps": "./bin/analyze-deps"
  }
}
